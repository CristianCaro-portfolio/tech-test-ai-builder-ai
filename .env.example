# Optional. With no key the pipeline runs fully offline (deterministic, zero cost);
# the numbers in the PR were produced in that mode. Set exactly one key to enable
# LLM synthesis with function calling through the provider's OpenAI-compatible API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Model for LLM mode. Final LLM-mode numbers were run against claude-haiku-4-5 (see DECISIONS.md).
MODEL=

# Override the provider base URL (any OpenAI-compatible /chat/completions endpoint).
LLM_BASE_URL=

# Force offline mode even when a key is present.
HOLLOW_OFFLINE=0
# Make the simulated deployment API flaky (0..1) to exercise the retry path.
TOOL_FAILURE_RATE=0
